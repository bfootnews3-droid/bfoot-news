<footer class="site-footer">
  <div class="container foot-in">
    <div class="foot-brand">
      <img src="/static/img/logo.png" alt="BFOOT NEWS" width="64" height="64" loading="lazy">
      <div><strong>BFOOT NEWS</strong><p><%= t('footer_about') %></p></div>
    </div>
    <div>
      <h4><%= t('follow_us') %></h4>
      <ul class="socials">
        <% Object.entries(social).forEach(([name, url]) => { if (url) { %>
          <li><a href="<%= url %>" target="_blank" rel="noopener noreferrer me"><%= name %></a></li>
        <% } }) %>
      </ul>
    </div>
  </div>
  <div class="container copy">© <%= new Date().getFullYear() %> BFOOT NEWS — <%= t('rights') %></div>
</footer>
<script src="/static/js/app.js" defer></script>
</body>
</html>
