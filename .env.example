PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Compte admin (utilisé UNIQUEMENT à la première création).
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et affiché dans la console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optionnel : sinon généré automatiquement dans data/.secret
JWT_SECRET=

# Mettre 1 si derrière un proxy/CDN (Render, Railway, Nginx, Cloudflare...)
TRUST_PROXY=0

# Nombre max de votes par adresse IP et par sondage (réseaux partagés)
VOTES_PER_IP=3

FACEBOOK_URL=https://www.facebook.com/share/19vmMZChko/
INSTAGRAM_URL=https://www.instagram.com/b_foot_news/
TIKTOK_URL=https://www.tiktok.com/@bfoot.news
