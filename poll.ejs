<%- include('partials/header', { active: 'polls' }) %>
<main class="container narrow">
  <%- include('partials/poll', { p }) %>
  <div class="share">
    <span><%= t('share') %> :</span>
    <% const u = encodeURIComponent(SITE_URL + '/' + lang + '/polls/' + p.id); %>
    <a href="https://www.facebook.com/sharer/sharer.php?u=<%= u %>" target="_blank" rel="noopener">Facebook</a>
    <a href="https://wa.me/?text=<%= u %>" target="_blank" rel="noopener">WhatsApp</a>
  </div>
</main>
<%- include('partials/footer') %>
