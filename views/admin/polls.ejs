<%- include('partials/header', { active: 'polls', meta: { title: t('nav_polls') } }) %>
<main class="container">
  <div class="sec-head page-head"><h1 class="sec-title"><%= t('nav_polls') %></h1></div>
  <% if (!polls.length) { %><p class="empty"><%= t('no_content') %></p><% } else { %>
  <div class="grid polls-grid"><% polls.forEach(p => { %><%- include('partials/poll', { p }) %><% }) %></div>
  <%- include('partials/pager') %>
  <% } %>
</main>
<%- include('partials/footer') %>
